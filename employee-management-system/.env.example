# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==========================================
# Location: employee-management-system/backend/.env

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_management_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-replace-with-a-strong-secret-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Admin Seed Account
ADMIN_EMAIL="admin@company.com"
ADMIN_PASSWORD="Admin@123"

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ==========================================
# Location: employee-management-system/frontend/.env

VITE_API_URL="/api"
