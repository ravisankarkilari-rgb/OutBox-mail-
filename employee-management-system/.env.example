# ==========================================
# OUTBOX MAIL SCHEDULER ENVIRONMENT VARIABLES
# ==========================================

# Database Connection (SQLite)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="outbox-mail-super-secure-jwt-secret-key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="outbox-mail-super-secure-refresh-key"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Optional Default SMTP Settings (Can also be set in the UI Settings)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# Frontend API URL
VITE_API_URL="/api"
