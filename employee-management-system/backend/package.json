{
  "name": "ems-backend",
  "version": "1.0.0",
  "description": "Production-grade Employee Management System Backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "db:sqlite": "node switch-db.js sqlite",
    "db:postgres": "node switch-db.js postgres",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [
    "employee-management",
    "express",
    "prisma",
    "jwt",
    "rest-api"
  ],
  "author": "Antigravity EMS Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^25.1.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "resolver": "./jest.resolver.js"
  }
